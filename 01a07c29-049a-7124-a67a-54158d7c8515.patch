new file mode 100644
index 0000000..413c223
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,13 @@
+FROM python:3.11-slim
+ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
+WORKDIR /app
+COPY tools/requirements.txt tools/requirements.txt
+COPY server/requirements.txt server/requirements.txt
+RUN pip install --no-cache-dir -r server/requirements.txt
+COPY . .
+RUN useradd --uid 10001 --create-home studio && mkdir -p /data/oj-studio && chown -R studio:studio /data
+USER studio
+ENV PORT=8002 OJ_DATA_DIR=/data/oj-studio
+EXPOSE 8002
+VOLUME ["/data"]
+CMD ["python", "-m", "server"]
