+          </div>
+          <div class="faq-item">
+            <button class="faq-q" aria-expanded="false">I don't know how to pose — help?<span class="fx"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></span></button>
