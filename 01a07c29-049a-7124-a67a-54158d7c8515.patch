diff --git a/assets/js/collection.js b/assets/js/collection.js
new file mode 100644
index 0000000..02f9ba9
--- /dev/null
+++ b/assets/js/collection.js
@@ -0,0 +1,46 @@
+/* A shareable, server/static-rendered collection works before JavaScript loads. */
+(function () {
+  "use strict";
+  var photos = JSON.parse(document.getElementById("collectionData").textContent);
+  var dialog = document.getElementById("collectionLightbox");
+  var image = document.getElementById("pagePhoto");
+  var index = 0;
+  function render() {
+    var photo = photos[index];
+    if (!photo) return;
+    // Resolve against the already-rendered image, including the site's hosting prefix.
+    image.src = document.querySelector('#pagePhotoGrid [data-index="' + index + '"] img').src;
+    image.alt = photo.alt;
+    document.getElementById("pagePhotoCount").textContent = (index + 1) + " / " + photos.length;
+  }
+  function move(direction) {
+    if (!photos.length) return;
+    index = (index + direction + photos.length) % photos.length;
+    render();
+  }
+  document.getElementById("pagePhotoGrid").addEventListener("click", function (event) {
+    var cell = event.target.closest("[data-index]");
+    if (!cell) return;
+    index = Number(cell.dataset.index);
+    render();
+    dialog.showModal();
+  });
+  document.getElementById("pagePhotoClose").addEventListener("click", function () { dialog.close(); });
+  document.getElementById("pagePhotoPrev").addEventListener("click", function () { move(-1); });
+  document.getElementById("pagePhotoNext").addEventListener("click", function () { move(1); });
+  dialog.addEventListener("keydown", function (event) {
+    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
+      event.preventDefault(); move(event.key === "ArrowLeft" ? -1 : 1);
+    }
+  });
+  dialog.addEventListener("close", function () { if (!dialog.open) image.removeAttribute("src"); });
+  document.getElementById("copyCollectionLink").addEventListener("click", async function () {
+    var status = document.getElementById("shareStatus");
+    try {
+      await navigator.clipboard.writeText(location.href.split("#")[0]);
+      status.textContent = "Collection link copied.";
+    } catch (err) {
+      status.textContent = "Copy this address: " + location.href.split("#")[0];
+    }
+  });
+})();
