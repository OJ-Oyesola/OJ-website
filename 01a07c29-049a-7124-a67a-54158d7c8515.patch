+"""Streaming, uncompressed ZIPs: bounded memory and byte-identical original entries."""
+import io
+import re
+import time
+import zipfile
+
+
+class ChunkWriter(io.RawIOBase):
+    def __init__(self):
+        super().__init__()
+        self.chunks = []
+        self.offset = 0
+
+    def writable(self):
+        return True
+
+    def seekable(self):
+        return False
+
+    def tell(self):
+        return self.offset
+
+    def write(self, value):
+        self.chunks.append(bytes(value))
+        self.offset += len(value)
+        return len(value)
+
+    def drain(self):
+        chunks, self.chunks = self.chunks, []
+        return chunks
+
+
+def stream_original_zip(files, still_authorized):
+    output = ChunkWriter()
+    names = set()
+    with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_STORED, allowZip64=True) as archive:
+        for index, file in enumerate(files, 1):
+            name = file["name"].replace("\\", "/").split("/")[-1]
+            name = re.sub(r'[\x00-\x1f\x7f<>:"|?*]', "_", name).strip(" .") or f"photo-{index}"
+            if name in names:
+                name = f"{index:03d}-{name}"
+            while name in names:
+                name = "copy-" + name
+            names.add(name)
+            if not still_authorized():
+                raise PermissionError("Download access ended")
+            info = zipfile.ZipInfo(name, time.localtime(file["path"].stat().st_mtime)[:6])
+            info.compress_type = zipfile.ZIP_STORED
+            with archive.open(info, "w", force_zip64=True) as entry, open(file["path"], "rb") as original:
+                for chunk in iter(lambda: original.read(1024 * 1024), b""):
+                    if not still_authorized():
+                        raise PermissionError("Download access ended")
+                    entry.write(chunk)
+                    yield from output.drain()
+            yield from output.drain()
+    yield from output.drain()
