+import hashlib
+from io import BytesIO
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+import zipfile
+
+from PIL import Image
+from werkzeug.security import generate_password_hash
+from flask.testing import FlaskClient
+
+from server.app import ROOT, create_app
+
+PASSWORD = "only-for-local-automated-tests"
+
+
+def photo_bytes(format="JPEG", size=(600, 400), exif=False):
+    file = BytesIO()
+    image = Image.new("RGB", size, "#997755")
+    metadata = Image.Exif()
+    if exif:
+        metadata[270] = "Original metadata must survive delivery"
+        metadata[274] = 6
+    image.save(file, format=format, exif=metadata)
+    return file.getvalue()
+
+
+class BufferedClient(FlaskClient):
+    def open(self, *args, **kwargs):
+        kwargs.setdefault("buffered", True)
+        response = super().open(*args, **kwargs)
+        response.request.environ["wsgi.input"].close()
+        return response
+
+
+class ManagedServerTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.password_hash = generate_password_hash(PASSWORD)
+
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        self.directory = Path(directory.name)
+        self.app = create_app({"TESTING": True, "DATA_DIR": directory.name, "ADMIN_PASSWORD_HASH": self.password_hash,
+                               "SECURE_COOKIES": False, "SEED_PORTFOLIO": False, "SITE_URL": "http://localhost/"})
+        self.app.test_client_class = BufferedClient
+        self.admin = self.app.test_client()
+        token = self.admin.get("/api/admin/session").get_json()["csrf"]
+        response = self.admin.post("/api/admin/login", json={"password": PASSWORD}, headers={"X-CSRF-Token": token})
+        self.assertEqual(response.status_code, 200)
+        self.csrf = response.get_json()["csrf"]
+        self.headers = {"X-CSRF-Token": self.csrf}
+
+    def collection(self, kind="delivery", title="Client delivery", **fields):
+        data = {"kind": kind, "title": title, "cat": "portraits", "email": "client@example.com", "expires": "2035-12-31", **fields}
+        response = self.admin.post("/api/admin/collections", json=data, headers=self.headers)
+        self.assertEqual(response.status_code, 201, response.get_data(as_text=True))
+        return response.get_json()
+
+    def upload(self, collection, original=None, name="original.jpg", **data):
+        original = original if original is not None else photo_bytes()
+        response = self.admin.post("/api/admin/collections/" + collection["id"] + "/photos",
+                                   data={"photo": (BytesIO(original), name), **data}, headers=self.headers)
+        self.assertEqual(response.status_code, 201, response.get_data(as_text=True))
+        return response.get_json()["photo"]
+
+    def publish(self, collection):
+        response = self.admin.patch("/api/admin/collections/" + collection["id"], json={"published": True, "confirmPublic": True}, headers=self.headers)
+        self.assertEqual(response.status_code, 200, response.get_data(as_text=True))
+
+    def client_login(self, code, email="client@example.com"):
+        client = self.app.test_client()
+        csrf = client.get("/api/client/session").get_json()["csrf"]
+        result = client.post("/api/client/login", json={"email": email, "code": code}, headers={"X-CSRF-Token": csrf})
+        self.assertEqual(result.status_code, 200, result.get_data(as_text=True))
+        return client, result.get_json()
+
+    def test_anonymous_uploads_listing_and_private_files_are_denied(self):
+        anonymous = self.app.test_client()
+        self.assertEqual(anonymous.get("/api/admin/collections").status_code, 401)
+        self.assertEqual(anonymous.post("/api/admin/collections/anything/photos").status_code, 401)
+        self.assertEqual(anonymous.get("/api/client/photos/anything/original").status_code, 401)
+        for path in ("/.git/config", "/.env", "/server/app.py", "/.local/oj-data/site.sqlite3", "/assets/../server/app.py"):
+            self.assertEqual(anonymous.get(path).status_code, 404, path)
+
+    def test_admin_sign_in_stays_locked_without_configuration(self):
+        self.app.config["ADMIN_PASSWORD_HASH"] = ""
+        self.assertEqual(self.admin.get("/api/admin/collections").status_code, 401)
+        with tempfile.TemporaryDirectory() as directory:
+            app = create_app({"TESTING": True, "DATA_DIR": directory, "ADMIN_PASSWORD_HASH": "", "SECURE_COOKIES": False, "SEED_PORTFOLIO": False})
+            self.assertFalse(app.test_client().get("/api/admin/session").get_json()["configured"])
+
+    def test_writes_require_csrf_and_the_website_origin(self):
+        self.assertEqual(self.admin.post("/api/admin/collections", json={}).status_code, 403)
+        for origin in ("https://attacker.example", "http://[invalid"):
+            response = self.admin.post("/api/admin/collections", json={}, headers={**self.headers, "Origin": origin})
+            self.assertEqual(response.status_code, 403)
+
+    def test_password_guessing_is_rate_limited(self):
+        client = self.app.test_client()
+        csrf = client.get("/api/admin/session").get_json()["csrf"]
+        for _ in range(8):
+            response = client.post("/api/admin/login", json={"password": "incorrect"}, headers={"X-CSRF-Token": csrf})
+            self.assertEqual(response.status_code, 401)
+        self.assertEqual(client.post("/api/admin/login", json={"password": PASSWORD}, headers={"X-CSRF-Token": csrf}).status_code, 429)
+
+    def test_secure_private_cookies_and_https_enforcement(self):
+        self.app.config["SECURE_COOKIES"] = True
+        client = self.app.test_client()
+        self.assertEqual(client.get("/api/admin/session").status_code, 400)
+        response = client.get("/api/admin/session", base_url="https://localhost")
+        cookie = response.headers["Set-Cookie"]
+        for flag in ("Secure", "HttpOnly", "SameSite=Strict", "Path=/api/admin"):
+            self.assertIn(flag, cookie)
+        self.assertIn("no-store", response.headers["Cache-Control"])
+
+    def test_public_portfolio_uses_only_compressed_copies_and_named_pages(self):
+        collection = self.collection("portfolio", "Ayo & Ola Studio")["collection"]
+        original = photo_bytes(size=(4000, 3000), exif=True)
+        photo = self.upload(collection, original)
+        self.assertEqual(self.app.test_client().get("/ayo-ola-studio/").status_code, 404)
+        bad_publish = self.admin.patch("/api/admin/collections/" + collection["id"], json={"published": True}, headers=self.headers)
+        self.assertEqual(bad_publish.status_code, 400)
+        self.publish(collection)
+        public = self.app.test_client()
+        data = public.get("/api/portfolio").get_json()["collections"][0]
+        item = data["photos"][0]
+        self.assertNotIn("originalName", item)
+        self.assertNotIn("full", item)
+        self.assertNotIn("sha256", item)
+        self.assertIn("srcset", item)
+        preview = public.get("/" + item["src"])
+        self.assertEqual(preview.mimetype, "image/webp")
+        with Image.open(BytesIO(preview.data)) as image:
+            self.assertLessEqual(max(image.size), 1600)
+            self.assertEqual(len(image.getexif()), 0)
+        page = public.get("/ayo-ola-studio/").get_data(as_text=True)
+        self.assertIn("Creating timeless images, seeing you better...", page)
+        self.assertIn("About%20Page/IMG_9627BW.jpg", page)
+        self.assertIn('rel="canonical" href="http://localhost/ayo-ola-studio/"', page)
+        self.assertIn("/ayo-ola-studio/", public.get("/sitemap.xml").get_data(as_text=True))
+        self.assertEqual(public.get("/api/admin/photos/" + photo["id"] + "/original").status_code, 401)
+        self.assertEqual(self.admin.get("/" + photo["full"]).data, original)
+
+    def test_upload_into_a_public_collection_requires_explicit_confirmation(self):
+        collection = self.collection("portfolio", "Published portfolio")["collection"]
+        self.upload(collection)
+        self.publish(collection)
+        response = self.admin.post("/api/admin/collections/" + collection["id"] + "/photos",
+                                   data={"photo": (BytesIO(photo_bytes()), "another.jpg")}, headers=self.headers)
+        self.assertEqual(response.status_code, 400)
+
+    def test_original_jpeg_keeps_full_resolution_and_embedded_metadata(self):
+        delivery = self.collection()
+        original = photo_bytes(size=(6000, 4000), exif=True)
+        self.upload(delivery["collection"], original, "High resolution.JPG")
+        self.publish(delivery["collection"])
+        client, data = self.client_login(delivery["accessCode"])
+        photo = data["data"]["photos"][0]
+        response = client.get("/" + photo["full"])
+        self.assertEqual(response.data, original)
+        self.assertEqual(photo["sha256"], hashlib.sha256(original).hexdigest())
+        self.assertEqual((photo["w"], photo["h"]), (4000, 6000))
+        with Image.open(BytesIO(response.data)) as image:
+            self.assertEqual(image.size, (6000, 4000))
+            self.assertEqual(image.getexif()[274], 6)
+            self.assertEqual(image.getexif()[270], "Original metadata must survive delivery")
+        self.assertIn("attachment", response.headers["Content-Disposition"])
