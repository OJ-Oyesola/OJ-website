+"""Opaque, revocable server-side sessions. No admin credentials are sent to browser config."""
+from functools import wraps
+import hashlib
+import hmac
+import secrets
+import time
+from urllib.parse import urlsplit
+
+from flask import abort, current_app, g, jsonify, request
+
+
+def store():
+    return current_app.extensions["store"]
+
+
+def token_hash(value):
+    return hashlib.sha256(value.encode()).hexdigest()
+
+
+def cookie_name(scope):
+    return "oj_" + scope + "_session"
+
+
+def session_for(scope):
+    token = request.cookies.get(cookie_name(scope), "")
+    if not token or len(token) > 100:
+        return None
+    row = store().one("SELECT * FROM sessions WHERE token_hash=? AND scope=? AND expires>?",
+                      (token_hash(token), scope, int(time.time())))
+    if row and scope == "admin" and row["authorized"] and row["auth_version"] != current_app.config["AUTH_VERSION"]:
+        return None
+    return row
+
+
+def revoke(scope):
+    token = request.cookies.get(cookie_name(scope), "")
+    if token:
+        store().execute("DELETE FROM sessions WHERE token_hash=?", (token_hash(token),))
+
+
+def issue(scope, authorized=False, gallery_id=None, payload=None):
+    revoke(scope)
+    token, csrf = secrets.token_urlsafe(32), secrets.token_urlsafe(32)
+    lifetime = 4 * 3600 if authorized else 15 * 60
+    now = int(time.time())
+    with store().connect() as db:
+        db.execute("DELETE FROM sessions WHERE expires<=?", (now,))
+        db.execute("INSERT INTO sessions VALUES(?,?,?,?,?,?,?)", (token_hash(token), scope, int(authorized), gallery_id,
+                   csrf, now + lifetime, current_app.config["AUTH_VERSION"] if scope == "admin" else ""))
+    response = jsonify({**(payload or {}), "authenticated": authorized, "csrf": csrf})
+    response.set_cookie(cookie_name(scope), token, httponly=True, secure=current_app.config["SECURE_COOKIES"],
+                        samesite="Strict", max_age=lifetime, path="/api/" + scope)
+    return response
+
+
+def bootstrap(scope, **payload):
+    row = session_for(scope)
+    if not row:
+        return issue(scope, payload=payload)
+    return jsonify({**payload, "authenticated": bool(row["authorized"]), "csrf": row["csrf"]})
+
+
+def check_csrf(scope):
+    origin = request.headers.get("Origin")
+    if origin:
+        try:
+            parsed = urlsplit(origin)
+            allowed = parsed.netloc.lower() == request.host.lower() and parsed.scheme in {"http", "https"}
+        except ValueError:
+            allowed = False
+        if not allowed:
+            abort(403, "Cross-origin writes are not allowed.")
+    row = session_for(scope)
+    supplied = request.headers.get("X-CSRF-Token", "")
+    if not row or not supplied or not hmac.compare_digest(supplied.encode(), row["csrf"].encode()):
+        abort(403, "Your session has changed. Refresh the page and try again.")
+    return row
+
+
+def admin_required(function):
+    @wraps(function)
+    def wrapped(*args, **kwargs):
+        row = session_for("admin")
+        if not current_app.config["ADMIN_PASSWORD_HASH"] or not row or not row["authorized"]:
+            abort(401, "Sign in to administer the website.")
+        if request.method not in {"GET", "HEAD", "OPTIONS"}:
+            check_csrf("admin")
+        g.admin_session = row
+        return function(*args, **kwargs)
+    return wrapped
+
+
+def delivery_required(function):
+    @wraps(function)
+    def wrapped(*args, **kwargs):
+        row = session_for("client")
+        if not row or not row["authorized"]:
+            abort(401, "Please access your client gallery again.")
+        gallery = store().one("SELECT * FROM collections WHERE id=? AND kind='delivery' AND published=1", (row["gallery_id"],))
+        from .app import expired
+        if not gallery or expired(gallery):
+            abort(403, "This gallery is not available. Please contact the photographer.")
+        g.client_gallery = gallery
+        return function(*args, **kwargs)
+    return wrapped
+
+
+def login_limit(scope, identity=""):
+    # Do not trust arbitrary X-Forwarded-For headers; trusted proxy handling is an explicit host setting.
+    key = token_hash(scope + "|" + (request.remote_addr or "unknown") + "|" + identity)
+    now = int(time.time())
+    with store().connect() as db:
+        db.execute("DELETE FROM login_attempts WHERE started<?", (now - 600,))
+        row = db.execute("SELECT count FROM login_attempts WHERE key=?", (key,)).fetchone()
+        if row and row["count"] >= 8:
+            abort(429, "Too many attempts. Please wait ten minutes before trying again.")
+        db.execute("INSERT INTO login_attempts VALUES(?,1,?) ON CONFLICT(key) DO UPDATE SET count=count+1", (key, now))
+    return key
diff --git a/server/store.py b/server/store.py
new file mode 100644
index 0000000..8758b61
--- /dev/null
+++ b/server/store.py
@@ -0,0 +1,68 @@
+import json
+from contextlib import contextmanager
+from pathlib import Path
+import sqlite3
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS collections (
+ id TEXT PRIMARY KEY, kind TEXT NOT NULL CHECK(kind IN ('portfolio','delivery')),
+ slug TEXT UNIQUE NOT NULL, title TEXT NOT NULL, cat TEXT NOT NULL DEFAULT '',
+ description TEXT NOT NULL DEFAULT '', subtitle TEXT NOT NULL DEFAULT '', date TEXT NOT NULL DEFAULT '',
+ email TEXT, code_hash TEXT, expires TEXT, published INTEGER NOT NULL DEFAULT 0
+);
+CREATE TABLE IF NOT EXISTS photos (
+ id TEXT PRIMARY KEY, collection_id TEXT NOT NULL REFERENCES collections(id),
+ source_path TEXT, storage_key TEXT, metadata TEXT NOT NULL, position INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS photo_collection ON photos(collection_id, position);
+CREATE INDEX IF NOT EXISTS delivery_email ON collections(email, kind);
+CREATE TABLE IF NOT EXISTS sessions (
+ token_hash TEXT PRIMARY KEY, scope TEXT NOT NULL, authorized INTEGER NOT NULL DEFAULT 0,
+ gallery_id TEXT, csrf TEXT NOT NULL, expires INTEGER NOT NULL, auth_version TEXT NOT NULL DEFAULT ''
+);
+CREATE TABLE IF NOT EXISTS downloads (
+ token_hash TEXT PRIMARY KEY, session_hash TEXT NOT NULL REFERENCES sessions(token_hash) ON DELETE CASCADE,
+ gallery_id TEXT NOT NULL, photo_ids TEXT NOT NULL, filename TEXT NOT NULL, expires INTEGER NOT NULL
+);
+CREATE TABLE IF NOT EXISTS login_attempts (key TEXT PRIMARY KEY, count INTEGER NOT NULL, started INTEGER NOT NULL);
+"""
+
+
+class Store:
+    def __init__(self, directory):
+        self.directory = Path(directory).resolve()
+        self.directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+        self.directory.chmod(0o700)
+        self.path = self.directory / "site.sqlite3"
+        (self.directory / "files").mkdir(exist_ok=True, mode=0o700)
+        with self.connect() as db:
+            db.executescript(SCHEMA)
+        self.path.chmod(0o600)
+
+    @contextmanager
+    def connect(self):
+        db = sqlite3.connect(self.path, timeout=30)
+        db.row_factory = sqlite3.Row
+        db.execute("PRAGMA foreign_keys=ON")
+        try:
+            with db:
+                yield db
+        finally:
+            db.close()
+
+    def query(self, sql, values=()):
+        with self.connect() as db:
+            return [dict(row) for row in db.execute(sql, values).fetchall()]
+
+    def one(self, sql, values=()):
+        rows = self.query(sql, values)
+        return rows[0] if rows else None
+
+    def execute(self, sql, values=()):
+        with self.connect() as db:
+            db.execute(sql, values)
+
+
+def read_manifest(root):
+    text = (root / "assets/js/galleries.js").read_text(encoding="utf-8")
+    return json.JSONDecoder().raw_decode(text.split("window.OJ_GALLERIES = ", 1)[1].lstrip())[0]
