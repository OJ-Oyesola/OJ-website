+      <p class="cv-cat">{{ collection.cat }}</p>
+      <h1 class="cv-title">{{ collection.title }}</h1>
+      <p class="cv-desc">{{ collection.desc }}</p>
+      <div class="collection-links">
+        <button type="button" class="text-link" id="copyCollectionLink">Copy collection link</button>
+        <a class="text-link" href="{{ prefix }}index.html#contact">Book a session</a>
+      </div>
+      <p id="shareStatus" role="status"></p>
+    </div>
+    <div class="cv-grid" id="pagePhotoGrid">
+{% for photo in collection.photos %}
+      <button type="button" class="cv-item" data-index="{{ loop.index0 }}" aria-label="View {{ photo.alt }}">
+        <img src="{{ prefix }}{{ photo.src }}" alt="{{ photo.alt }}" width="{{ photo.w }}" height="{{ photo.h }}" loading="lazy" decoding="async"{% if photo.srcset %} srcset="{{ photo.srcset }}" sizes="(min-width: 76rem) 22vw, (min-width: 52rem) 30vw, (min-width: 26rem) 46vw, 92vw"{% endif %}>
