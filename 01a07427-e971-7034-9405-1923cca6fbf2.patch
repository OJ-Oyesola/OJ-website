+.page-header .menu-link { display: inline-flex; gap: 0.5rem; align-items: center; font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
+@media (min-width: 55rem) { .page-header .menu-link { display: none; } }
+.page-header .menu-link svg { width: 1rem; height: 1rem; }
+
+/* ---------- Misc ---------- */
+.skip-link {
+  position: absolute; left: 1rem; top: -4rem; z-index: 200;
+  background: var(--ink); color: var(--ivory); padding: 0.7rem 1.2rem; border-radius: 4px;
+  font-size: 0.8rem; transition: top 0.3s;
+}
+.skip-link:focus { top: 1rem; }
+:focus-visible { outline: 2px solid var(--brass); outline-offset: 3px; }
