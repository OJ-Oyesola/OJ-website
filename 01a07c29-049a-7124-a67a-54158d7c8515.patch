@@ -0,0 +1,63 @@
+"""Owner-only local setup commands. Run on the host; no GitHub or external account API calls."""
+import argparse
+from getpass import getpass
+import json
+from pathlib import Path
+import shutil
+import tempfile
+import uuid
+
+from werkzeug.security import generate_password_hash
+
+from tools.media import image_info, prepare_web_variants, preserve_original
+from .app import ROOT, create_app
+
+
+def optimise_existing(app):
+    storage = app.extensions["store"]
+    rows = storage.query("SELECT * FROM photos WHERE source_path IS NOT NULL ORDER BY collection_id,position")
+    completed = 0
+    for row in rows:
+        source = (ROOT / row["source_path"]).resolve()
+        if not source.is_relative_to(ROOT):
+            raise ValueError("Unsafe source path")
+        key = uuid.uuid4().hex
+        dest = storage.directory / "files" / key
+        with tempfile.TemporaryDirectory(prefix="prepare-", dir=storage.directory) as temporary:
+            prepared = Path(temporary) / "prepared"
+            prepared.mkdir()
+            metadata = image_info(source)
+            original = "original" + source.suffix.lower()
+            metadata.update(preserve_original(source, prepared / original))
+            metadata["original"] = original
+            metadata["alt"] = json.loads(row["metadata"])["alt"]
+            metadata["variants"] = [{**v, "edge": int(Path(v["file"]).stem)} for v in prepare_web_variants(source, prepared)]
+            prepared.rename(dest)
+            try:
+                storage.execute("UPDATE photos SET source_path=NULL,storage_key=?,metadata=? WHERE id=?", (key, json.dumps(metadata), row["id"]))
+            except Exception:
+                shutil.rmtree(dest)  # Only the new, unpublished prepared copy.
+                raise
+        completed += 1
+        print(f"Prepared {completed}/{len(rows)} public portfolio photos", flush=True)
+    print(f"Complete: {completed} photographs prepared. Repository originals were not modified.")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("command", choices=("password-hash", "optimise-existing"))
+    args = parser.parse_args()
+    if args.command == "password-hash":
+        password = getpass("Choose a unique admin password (14+ characters): ")
+        if len(password) < 14 or len(password) > 1024:
+            raise SystemExit("Use a password between 14 and 1024 characters.")
+        if getpass("Repeat the password: ") != password:
+            raise SystemExit("Passwords did not match.")
+        print("Store this hash in your host's OJ_ADMIN_PASSWORD_HASH secret setting; do not commit it:")
+        print(generate_password_hash(password))
+    else:
+        optimise_existing(create_app())
+
+
+if __name__ == "__main__":
+    main()
