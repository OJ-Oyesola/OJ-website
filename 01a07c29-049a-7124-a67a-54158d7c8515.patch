@@ -0,0 +1,98 @@
+const { test, expect, fillBooking } = require("./helpers");
+
+test("dated inquiries email a reviewable calendar draft without reserving a date", async ({ page }) => {
+  let submission;
+  await page.route("https://formspree.io/**", route => {
+    submission = route.request().postDataJSON();
+    return route.fulfill({ json: { ok: true } });
+  });
+  await page.goto("index.html");
+  await fillBooking(page);
+  await page.locator("#f-date").fill("2027-12-31");
+  await page.locator("#f-usage").fill("Business website and an agreed social campaign.");
+  await page.locator('#bookingForm button[type="submit"]').click();
+  await expect(page.locator("#formSuccess")).toBeVisible();
+  const calendar = new URL(submission.google_calendar_link);
+  expect(calendar.origin).toBe("https://calendar.google.com");
+  expect(calendar.searchParams.get("dates")).toBe("20271231/20280101");
+  expect(calendar.searchParams.get("ctz")).toBe("Africa/Lagos");
+  expect(calendar.searchParams.get("text")).toContain("To confirm");
+  expect(submission.calendar_note).toContain("does not create an event or reserve a date");
+  expect(submission.usage_scope).toContain("Business website");
+  expect(submission.submitted_at_utc).toMatch(/^\d{4}-\d{2}-\d{2}T/);
+});
+
+test("agreements email their exact terms, version, consent and commercial usage", async ({ page }) => {
+  let submission;
+  await page.route("https://formspree.io/**", route => {
+    submission = route.request().postDataJSON();
+    return route.fulfill({ json: { ok: true } });
+  });
+  await page.goto("contract.html");
+  await page.locator("#c-first").fill("Test");
+  await page.locator("#c-last").fill("Client");
+  await page.locator("#c-email").fill("test@example.com");
+  await page.locator("#c-date").fill("2028-02-29");
+  await page.locator("#c-type").selectOption({ label: "Corporate & Branding" });
+  await page.locator("#c-sig").fill("Test Client");
+  await page.locator("#c-consent").check();
+  await page.locator('#contractForm button[type="submit"]').click();
+  expect(submission).toBeUndefined();
+  await page.locator("#c-usage").fill("Agreed at inquiry: company website and Instagram for twelve months.");
+  const terms = await page.locator("#agreementTerms").innerText();
+  await page.locator('#contractForm button[type="submit"]').click();
+  await expect(page.locator("#contractSuccess")).toBeVisible();
+  expect(submission.agreement_text).toBe(terms.trim());
+  expect(submission.agreement_version).toBe("2026-09-07");
+  expect(submission.consent).toBe("agreed");
+  expect(submission.typed_signature).toBe("Test Client");
+  expect(submission.usage_scope).toContain("company website");
+  expect(new URL(submission.google_calendar_link).searchParams.get("dates")).toBe("20280229/20280301");
+});
+
+test("the tagline, About portrait and canonical URL are present without JavaScript", async ({ browser, baseURL }) => {
+  const context = await browser.newContext({ javaScriptEnabled: false });
+  const page = await context.newPage();
+  await page.goto(new URL("index.html", baseURL).href);
+  await expect(page.locator('meta[name="description"]')).toHaveAttribute("content", "Creating timeless images, seeing you better...");
+  await expect(page.locator('meta[property="og:image"]')).toHaveAttribute("content", /About%20Page\/IMG_9627BW\.jpg$/);
+  await expect(page.locator('link[rel="canonical"]')).toHaveAttribute("href", "https://oj-oyesola.github.io/OJ-website/");
+  await context.close();
+});
+
+test("named collection pages have real HTML, generated alt text and a working viewer", async ({ page }) => {
+  await page.goto("crimson.html");
+  await expect(page.locator("h1")).toHaveText("Crimson");
+  await expect(page.locator('#pagePhotoGrid img').first()).toHaveAttribute("alt", /Editorial image from Crimson/);
+  await expect(page.locator('link[rel="canonical"]')).toHaveAttribute("href", /\/crimson\.html$/);
+  await page.locator("#pagePhotoGrid button").first().click();
+  await expect(page.locator("#collectionLightbox")).toBeVisible();
+  await page.keyboard.press("ArrowRight");
+  await expect(page.locator("#pagePhotoCount")).toHaveText(/^2 \/ /);
+  await page.keyboard.press("Escape");
+  await expect(page.locator("#collectionLightbox")).toBeHidden();
+});
+
+test("portfolio cards expose shareable named URLs while preserving modal browsing", async ({ page }) => {
+  await page.goto("index.html");
+  const tile = page.locator('[data-collection="crimson"].tile');
+  await expect(tile).toHaveAttribute("href", "crimson.html");
+  await tile.click();
+  await expect(page.locator("#cvShare")).toHaveAttribute("href", "crimson.html");
+  await page.locator("#cvShare").click();
+  await expect(page).toHaveURL(/crimson\.html$/);
+  await expect(page.locator("h1")).toHaveText("Crimson");
+});
+
+test("a stalled portfolio service never blocks booking submission", async ({ page }) => {
+  await page.addInitScript(() => document.addEventListener("DOMContentLoaded", () => { window.OJ_CONFIG.apiBase = "/api/"; }));
+  let release;
+  const gate = new Promise(resolve => { release = resolve; });
+  await page.route("**/api/portfolio", async route => { await gate; await route.fulfill({ json: { collections: [] } }); });
+  await page.route("https://formspree.io/**", route => route.fulfill({ json: { ok: true } }));
+  await page.goto("index.html", { waitUntil: "domcontentloaded" });
+  await fillBooking(page);
+  await page.locator('#bookingForm button[type="submit"]').click();
+  await expect(page.locator("#formSuccess")).toBeVisible();
+  release();
+});
