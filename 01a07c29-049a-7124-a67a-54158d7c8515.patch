+/* Email-only booking records and reviewable Google Calendar links. No OAuth or calendar writes. */
+(function () {
+  "use strict";
+  function addEmailRecords(data, form) {
+    data.submitted_at_utc = new Date().toISOString();
+    data.submission_type = form.id === "contractForm" ? "Signed agreement" : "Booking inquiry";
+    var terms = document.getElementById("agreementTerms");
+    if (form.id === "contractForm" && terms) {
+      data.agreement_version = terms.dataset.version;
+      data.agreement_text = terms.innerText.trim();
+    }
+    var date = data.session_date || data.preferred_date;
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(date || "")) return data;
+    var start = new Date(date + "T00:00:00Z");
+    if (!Number.isFinite(start.getTime()) || start.toISOString().slice(0, 10) !== date) return data;
+    var end = new Date(start.getTime() + 86400000);
+    var name = [data.first_name, data.last_name].filter(Boolean).join(" ");
+    var url = new URL("https://calendar.google.com/calendar/render");
+    url.searchParams.set("action", "TEMPLATE");
+    url.searchParams.set("text", "To confirm: " + (data.session_type || "Photography session") + " — " + name);
+    url.searchParams.set("dates", date.replace(/-/g, "") + "/" + end.toISOString().slice(0, 10).replace(/-/g, ""));
+    url.searchParams.set("ctz", (window.OJ_CONFIG || {}).calendarTimezone || "Africa/Lagos");
+    url.searchParams.set("details", "Requested date only. Review availability, payment and the agreed booking details before confirming. Set the session time before saving.\n\nClient: " + name + "\nEmail: " + data.email + "\n\nAgreement and consent records remain in the Formspree email.");
+    data.google_calendar_link = url.href;
+    data.calendar_note = "Review-and-add link only. This does not create an event or reserve a date. The draft is all-day until you set a time.";
+    return data;
+  }
+  window.OJBooking = { addEmailRecords: addEmailRecords };
+})();
