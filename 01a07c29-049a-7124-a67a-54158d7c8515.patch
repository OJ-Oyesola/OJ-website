+"""Shared image preparation. Originals are copied, never resized or re-encoded."""
+import hashlib
+from io import BytesIO
+from pathlib import Path
+import re
+import shutil
+import threading
+import unicodedata
+
+from PIL import Image, ImageCms, ImageOps
+
+EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp", ".avif", ".tif", ".tiff"}
+_OPEN_LOCK = threading.Lock()
+FORMATS = {"JPEG", "PNG", "WEBP", "AVIF", "TIFF"}
+RESERVED_SLUGS = {"api", "admin", "assets", "client", "contract", "privacy", "terms", "index", "404", "galleries", "media", "tools", "server", "tests"}
+
+
+def slugify(title):
+    text = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode().lower()
+    return re.sub(r"[^a-z0-9]+", "-", text).strip("-")[:90].rstrip("-")
+
+
+def auto_alt(title, category, number):
+    labels = {"portraits": "Portrait", "weddings": "Wedding", "editorial": "Editorial",
+              "events": "Event", "commercial": "Commercial"}
+    return f"{labels.get(category, 'Photography')} image from {title} — frame {number}."
+
+
+def image_info(source):
+    # Read headers without imposing a pixel ceiling on originals. Every open in
+    # this module shares the lock so the temporary setting cannot affect a preview.
+    with _OPEN_LOCK:
+        limit = Image.MAX_IMAGE_PIXELS
+        try:
+            Image.MAX_IMAGE_PIXELS = None
+            image = Image.open(source)
+        finally:
+            Image.MAX_IMAGE_PIXELS = limit
+    with image:
+        if image.format not in FORMATS:
+            raise ValueError("Use a JPEG, PNG, WebP, AVIF or TIFF image; SVG and executable uploads are not accepted.")
+        width, height = image.size
+        if image.getexif().get(274) in (5, 6, 7, 8):
+            width, height = height, width
+        return {"w": width, "h": height, "format": image.format}
+
+
+def file_digest(source):
+    digest = hashlib.sha256()
+    with open(source, "rb") as file:
+        for chunk in iter(lambda: file.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def preserve_original(source, target):
+    """Byte-for-byte copy, including original pixel dimensions, format and metadata."""
+    shutil.copyfile(source, target)
+    return {"originalName": Path(source).name, "bytes": Path(target).stat().st_size, "sha256": file_digest(target)}
+
+
+def web_image(source, long_edge=1600):
+    with _OPEN_LOCK:
+        original = Image.open(source)  # Normal Pillow safety limits apply to viewing copies.
+    with original:
+        # JPEG draft decoding reduces memory before making the viewing copy.
+        original.draft("RGB", (long_edge, long_edge))
+        image = ImageOps.exif_transpose(original)
+        mode = "RGBA" if "A" in image.getbands() or "transparency" in image.info else "RGB"
+        profile = original.info.get("icc_profile")
+        if profile:
+            try:
+                image = ImageCms.profileToProfile(image, ImageCms.ImageCmsProfile(BytesIO(profile)),
+                                                 ImageCms.createProfile("sRGB"), outputMode=mode)
+            except (ImageCms.PyCMSError, OSError, ValueError):
+                image = image.convert(mode)
+        else:
+            image = image.convert(mode)
+        image.thumbnail((long_edge, long_edge), Image.Resampling.LANCZOS)
+        return image
+
+
+def prepare_web_variants(source, dest, edges=(480, 960, 1600)):
+    """Create public/viewing WebP copies; EXIF/GPS metadata is deliberately not passed to save()."""
+    dest = Path(dest)
+    dest.mkdir(parents=True, exist_ok=True)
+    image = web_image(source, max(edges))
+    variants, seen = [], set()
+    for edge in edges:
+        preview = image.copy()
+        preview.thumbnail((edge, edge), Image.Resampling.LANCZOS)
+        if preview.size in seen:
+            continue
+        seen.add(preview.size)
+        name = f"{edge}.webp"
+        preview.save(dest / name, "WEBP", quality=82, method=4, exif=b"")
+        variants.append({"file": name, "w": preview.width, "h": preview.height})
+    return variants
