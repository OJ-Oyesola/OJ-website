+"""Shared SEO and collection-page rendering for static exports and the managed server."""
+import json
+from pathlib import Path
+import re
+from urllib.parse import urljoin, urlsplit
+
+from jinja2 import Environment, FileSystemLoader, select_autoescape
+
+ROOT = Path(__file__).resolve().parent.parent
+TEMPLATES = ROOT / "server/templates"
+
+
+def public_settings(root=ROOT, site_url=None):
+    text = (root / "assets/js/config.js").read_text(encoding="utf-8")
+    def value(name):
+        match = re.search(r'^\s*' + name + r'\s*:\s*("(?:[^"\\]|\\.)*")', text, re.MULTILINE)
+        if not match:
+            raise ValueError(f"Missing double-quoted {name} in config.js")
+        return json.loads(match.group(1))
+    base = (site_url or value("siteUrl")).rstrip("/") + "/"
+    url = urlsplit(base)
+    if url.scheme not in {"http", "https"} or not url.netloc or url.username or url.password or url.query or url.fragment:
+        raise ValueError("siteUrl must be an absolute HTTP(S) site-root URL without credentials, query or fragment")
+    return {"base": base, "tagline": value("tagline"), "image": urljoin(base, value("shareImage"))}
+
+
+def environment():
+    return Environment(loader=FileSystemLoader(TEMPLATES), autoescape=select_autoescape(["html", "xml"]),
+                       keep_trailing_newline=True)
+
+
+def seo_block(settings, canonical):
+    return environment().get_template("seo.html").render(site=settings, canonical=canonical)
+
+
+def render_collection(collection, settings, managed=False):
+    canonical = urljoin(settings["base"], collection["slug"] + ("/" if managed else ".html"))
+    return environment().get_template("collection.html").render(
+        collection=collection, site=settings, canonical=canonical, prefix="/" if managed else "",
+        managed=managed)
+
+
+def update_page_metadata(text, settings, relative):
+    canonical = settings["base"] if relative == "index.html" else urljoin(settings["base"], relative)
+    block = seo_block(settings, canonical)
+    if "<!-- SEO:START -->" in text:
+        text = re.sub(r'[ \t]*<!-- SEO:START -->.*?<!-- SEO:END -->[ \t]*\n?', lambda _: block, text, flags=re.DOTALL)
+    else:
+        text = re.sub(r'^\s*<meta\s+(?:name|property)="(?:description|og:[^"]+|twitter:[^"]+)"[^>]*>\s*$', '', text, flags=re.MULTILINE)
+        text = re.sub(r'^\s*<link\s+rel="canonical"[^>]*>\s*$', '', text, flags=re.MULTILINE)
+        text = re.sub(r'^\s*<!-- Open Graph / link previews[^\n]*\n', '', text, flags=re.MULTILINE)
+        text = text.replace('</title>', '</title>\n' + block.rstrip(), 1)
+    # Keep existing business facts; change only the requested description, image and site URL.
+    def structured(match):
+        data = json.loads(match.group(1))
+        if data.get("@type") == "ProfessionalService":
+            data.update(description=settings["tagline"], url=settings["base"], image=settings["image"])
+        return '<script type="application/ld+json">\n' + json.dumps(data, ensure_ascii=False, indent=2).replace('</', '<\\/') + '\n  </script>'
+    return re.sub(r'<script type="application/ld\+json">(.*?)</script>', structured, text, flags=re.DOTALL)
+
+
+def generated_pages(galleries, root=ROOT):
+    settings = public_settings(root)
+    pages = {root / (g["slug"] + ".html"): render_collection(g, settings) for g in galleries}
+    for name in ("index.html", "client.html", "contract.html", "privacy.html", "terms.html", "404.html", "admin.html"):
+        file = root / name
+        if file.exists():
+            pages[file] = update_page_metadata(file.read_text(encoding="utf-8"), settings, name)
+    urls = [settings["base"], urljoin(settings["base"], "privacy.html"), urljoin(settings["base"], "terms.html")]
+    urls += [urljoin(settings["base"], g["slug"] + ".html") for g in galleries]
+    pages[root / "sitemap.xml"] = environment().get_template("sitemap.xml").render(urls=urls)
+    return pages
