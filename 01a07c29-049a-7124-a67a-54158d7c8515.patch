+"""Same-origin managed website: private uploads, public viewing copies and protected originals."""
+import datetime as dt
+import hashlib
+import json
+import mimetypes
+import os
+from pathlib import Path
+import re
+import secrets
+import shutil
+import tempfile
+import time
+import uuid
+from urllib.parse import unquote, urljoin, urlsplit
+
+from flask import Flask, Response, abort, g, jsonify, request, send_file, stream_with_context
+from PIL import Image
+from werkzeug.exceptions import HTTPException
+from werkzeug.middleware.proxy_fix import ProxyFix
+from werkzeug.security import check_password_hash, generate_password_hash
+
+from tools.media import EXTENSIONS, RESERVED_SLUGS, auto_alt, image_info, prepare_web_variants, preserve_original, slugify
+from tools.site_pages import environment, public_settings, render_collection, update_page_metadata
+from .security import admin_required, bootstrap, check_csrf, cookie_name, delivery_required, issue, login_limit, revoke, token_hash
+from .store import Store, read_manifest
+from .archives import stream_original_zip
+
+ROOT = Path(__file__).resolve().parent.parent
+DEMO_HASHES = {"OJ-DEMO": "e5edec8a25350838873d0e638ce864b060c185a80fcd86265789500f527559d5",
+               "OJ-WEDDING": "c140eca7fd6f7d51802def97df3bd1cdc0528f94c6d193ff62a9440f09cb7da9"}
+CATEGORIES = {"portraits", "weddings", "events", "editorial", "commercial"}
+
+
+def expired(gallery):
+    return bool(gallery.get("expires")) and dt.datetime.now(dt.timezone.utc).date().isoformat() > gallery["expires"]
+
+
+def create_app(overrides=None):
+    app = Flask(__name__, static_folder=None)
+    app.config.update(
+        DATA_DIR=os.environ.get("OJ_DATA_DIR", str(ROOT / ".local/oj-data")),
+        ADMIN_PASSWORD_HASH=os.environ.get("OJ_ADMIN_PASSWORD_HASH", ""),
+        SITE_URL=os.environ.get("OJ_SITE_URL"), SECURE_COOKIES=os.environ.get("OJ_DEV_MODE") != "1",
+        MAX_CONTENT_LENGTH=int(os.environ.get("OJ_MAX_UPLOAD_MB", "128")) * 1024 * 1024,
+        SEED_PORTFOLIO=True, MAX_FORM_MEMORY_SIZE=128 * 1024, MAX_FORM_PARTS=16)
+    if overrides:
+        app.config.update(overrides)
+    if os.environ.get("OJ_TRUST_PROXY") == "1":
+        app.wsgi_app = ProxyFix(app.wsgi_app, x_for=1, x_proto=1, x_host=1)
+    password_hash = app.config["ADMIN_PASSWORD_HASH"]
+    if password_hash and (not password_hash.startswith(("scrypt:", "pbkdf2:sha256:")) or password_hash.count("$") != 2):
+        raise ValueError("Use python3 -m server.manage password-hash to generate OJ_ADMIN_PASSWORD_HASH; never put a plaintext password here.")
+    if password_hash and not app.config.get("TESTING") and not (os.environ.get("OJ_DATA_DIR") or overrides and overrides.get("DATA_DIR")):
+        raise ValueError("Set OJ_DATA_DIR to persistent private storage before enabling admin uploads.")
+    if password_hash and not app.config["SITE_URL"] and not app.config.get("TESTING"):
+        raise ValueError("Set OJ_SITE_URL to this managed server's public root URL before enabling admin access.")
+    if app.config["SITE_URL"]:
+        url = urlsplit(app.config["SITE_URL"])
+        if url.path not in {"", "/"}:
+            raise ValueError("Host the managed server at a domain root, and use that root as OJ_SITE_URL.")
+        if app.config["SECURE_COOKIES"] and url.scheme != "https":
+            raise ValueError("Production OJ_SITE_URL must use HTTPS. OJ_DEV_MODE=1 is for local testing only.")
+    app.config["AUTH_VERSION"] = token_hash(password_hash)
+    directory = Path(app.config["DATA_DIR"]).resolve()
+    if directory.is_relative_to(ROOT) and not directory.is_relative_to(ROOT / ".local"):
+        raise ValueError("Keep OJ_DATA_DIR outside the repository or inside .local; never inside public assets.")
+    storage = Store(directory)
+    app.extensions["store"] = storage
+    settings = public_settings(site_url=app.config["SITE_URL"])
+    app.extensions["site_settings"] = settings
+    manifest = read_manifest(ROOT)
+    approved_sources = set()
+    for collection in manifest:
+        for photo in collection["photos"]:
+            approved_sources.add(unquote(photo["src"]))
+    approved_sources.update(p.relative_to(ROOT).as_posix() for folder in ("Hero Images", "About Page") for p in (ROOT / folder).iterdir() if p.suffix.lower() in EXTENSIONS)
+    for demo in DEMO_HASHES.values():
+        approved_sources.update(p.relative_to(ROOT).as_posix() for p in (ROOT / "galleries" / demo).rglob("*") if p.is_file())
+    if app.config["SEED_PORTFOLIO"]:
+        with storage.connect() as db:
+            for collection in manifest:
+                db.execute("INSERT OR IGNORE INTO collections(id,kind,slug,title,cat,description,published) VALUES(?,'portfolio',?,?,?,?,1)",
+                           (collection["id"], collection["slug"], collection["title"], collection["cat"], collection["desc"]))
+                for index, photo in enumerate(collection["photos"]):
+                    identifier = "seed-" + hashlib.sha256((collection["id"] + "|" + photo["src"]).encode()).hexdigest()[:24]
+                    db.execute("INSERT OR IGNORE INTO photos VALUES(?,?,?,NULL,?,?)", (identifier, collection["id"],
+                               unquote(photo["src"]), json.dumps(photo), index))
+    dummy_code_hash = generate_password_hash(secrets.token_urlsafe(24))
+
+    @app.before_request
+    def require_private_https():
+        if request.path.startswith(("/api/admin", "/api/client")) and app.config["SECURE_COOKIES"] and not request.is_secure:
+            abort(400, "Private access requires HTTPS. Configure the trusted HTTPS reverse proxy on your host.")
+
+    @app.after_request
+    def headers(response):
+        response.headers["X-Content-Type-Options"] = "nosniff"
+        if request.is_secure:
+            response.headers["Strict-Transport-Security"] = "max-age=31536000"
+        response.headers["Referrer-Policy"] = "strict-origin-when-cross-origin"
+        response.headers["Permissions-Policy"] = "camera=(), microphone=(), geolocation=()"
+        if request.path.startswith(("/api/admin", "/api/client")) or request.path == "/admin.html":
+            response.headers["Cache-Control"] = "no-store, private"
+            response.headers["X-Robots-Tag"] = "noindex, nofollow, noarchive"
+        if request.path == "/admin.html":
+            response.headers["Content-Security-Policy"] = "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
+        return response
+
+    @app.errorhandler(HTTPException)
+    def api_error(error):
+        if request.path.startswith("/api/"):
+            message = "Upload exceeds this server's configured file-size limit. The image resolution has not been changed." if error.code == 413 else error.description
+            return jsonify(error=message), error.code
+        return update_page_metadata((ROOT / "404.html").read_text(), settings, "404.html"), error.code
+
+    @app.errorhandler(OSError)
+    def storage_error(error):
+        app.logger.error("Image storage operation failed: %s", type(error).__name__)
+        if request.path.startswith("/api/"):
+            return jsonify(error="Image storage is temporarily unavailable. Check available disk space and server resources, then retry. No original was resized."), 503
+        return "The site is temporarily unavailable.", 503
+
+    def payload(maximum=16384):
+        if request.content_length and request.content_length > maximum:
+            abort(413, "JSON request is too large.")
+        value = request.get_json(silent=True)
+        if not isinstance(value, dict):
+            abort(400, "A JSON object is required.")
+        return value
+
+    def field(data, key, default="", maximum=500):
+        value = data.get(key, default)
+        if not isinstance(value, str) or len(value) > maximum or "\x00" in value:
+            abort(400, "Invalid " + key + ".")
+        return value.strip()
+
+    def collection_or_404(identifier):
+        collection = storage.one("SELECT * FROM collections WHERE id=?", (identifier,))
+        if not collection:
+            abort(404, "Collection not found.")
+        return collection
+
+    def photo_payload(photo, audience):
+        metadata = json.loads(photo["metadata"])
+        if photo["source_path"]:
+            result = {**metadata, "id": photo["id"]}
+            if audience == "admin":
+                result["preview"] = "/api/admin/photos/" + photo["id"] + "/preview/1600"
+            return result
+        prefix = ("media/" if audience == "public" else "api/" + audience + "/photos/") + photo["id"] + "/preview/"
+        variants = [{"src": prefix + str(v["edge"]), "w": v["w"]} for v in metadata["variants"]]
+        result = {"id": photo["id"], "w": metadata["w"], "h": metadata["h"], "alt": metadata["alt"],
+                  "src": variants[-1]["src"], "grid": variants[min(1, len(variants) - 1)]["src"],
+                  "preview": variants[-1]["src"], "srcset": ", ".join("/" + v["src"] + " " + str(v["w"]) + "w" for v in variants)}
+        if metadata.get("previewUnavailable"):
+            result["previewUnavailable"] = True
+        if audience != "public":
+            result.update(originalName=metadata["originalName"], bytes=metadata["bytes"], sha256=metadata["sha256"],
+                          full="api/" + audience + "/photos/" + photo["id"] + "/original")
+        return result
+
+    def collection_payload(collection, audience="public"):
+        result = {"id": collection["id"], "slug": collection["slug"], "url": "/" + collection["slug"] + "/",
+                  "title": collection["title"], "cat": collection["cat"], "desc": collection["description"],
+                  "subtitle": collection["subtitle"], "date": collection["date"], "photos": []}
+        result["photos"] = [photo_payload(p, audience) for p in storage.query("SELECT * FROM photos WHERE collection_id=? ORDER BY position,id", (collection["id"],))]
+        if audience != "public":
+            result.update(kind=collection["kind"], expires=collection["expires"] or "", published=bool(collection["published"]))
+        if audience == "admin":
+            result["email"] = collection["email"] or ""
+        return result
+
+    @app.get("/api/admin/session")
+    def admin_session():
+        return bootstrap("admin", configured=bool(password_hash), siteUrl=settings["base"])
+
+    @app.post("/api/admin/login")
+    def admin_login():
+        check_csrf("admin")
+        if not password_hash:
+            abort(503, "Admin access is locked until the hosting owner configures a password hash.")
+        data = payload()
+        key = login_limit("admin")
+        password = data.get("password", "")
+        if not isinstance(password, str) or len(password) > 1024:
+            abort(400, "Invalid sign-in details.")
+        if not check_password_hash(password_hash, password):
+            abort(401, "Invalid sign-in details.")
+        storage.execute("DELETE FROM login_attempts WHERE key=?", (key,))
+        return issue("admin", authorized=True)
+
+    @app.post("/api/<scope>/logout")
+    def logout(scope):
+        if scope not in {"admin", "client"}:
+            abort(404)
+        check_csrf(scope)
+        revoke(scope)
+        response = jsonify(ok=True)
+        response.delete_cookie(cookie_name(scope), path="/api/" + scope, secure=app.config["SECURE_COOKIES"], httponly=True, samesite="Strict")
+        return response
+
+    @app.get("/api/admin/collections")
+    @admin_required
+    def admin_collections():
+        return jsonify(collections=[{key: row[key] for key in ("id", "kind", "title", "slug", "cat", "published", "count")} for row in storage.query(
+            "SELECT c.*,count(p.id) AS count FROM collections c LEFT JOIN photos p ON p.collection_id=c.id GROUP BY c.id ORDER BY c.title")])
+
+    @app.post("/api/admin/collections")
+    @admin_required
+    def create_collection():
