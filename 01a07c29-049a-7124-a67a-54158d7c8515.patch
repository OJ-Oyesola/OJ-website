diff --git a/tests/browser/admin.spec.js b/tests/browser/admin.spec.js
new file mode 100644
index 0000000..5d25d6d
--- /dev/null
+++ b/tests/browser/admin.spec.js
@@ -0,0 +1,116 @@
+const { test, expect, root, demoBase } = require("./helpers");
+const fs = require("node:fs/promises");
+const path = require("node:path");
+const crypto = require("node:crypto");
+const JSZip = require("jszip");
+
+const PASSWORD = "only-for-local-automated-tests";
+test.use({ baseURL: "http://127.0.0.1:8003/" });
+
+async function signIn(page) {
+  await page.goto("admin.html");
+  await expect(page.locator("#adminLoginButton")).toBeEnabled();
+  await page.locator("#adminPassword").fill(PASSWORD);
+  await page.locator("#adminLoginButton").click();
+  await expect(page.locator("#adminWorkspace")).toBeVisible();
+}
+
+async function createCollection(page, kind, title, email) {
+  await page.locator(".admin-create summary").click();
+  await page.locator("#collectionTitle").fill(title);
+  await page.locator("#collectionKind").selectOption(kind);
+  if (kind === "delivery") {
+    await page.locator("#deliveryEmail").fill(email);
+    await page.locator("#deliveryExpiry").fill("2035-12-31");
+  }
+  await page.locator('#newCollectionForm button[type="submit"]').click();
+  await expect(page.locator("#activeTitle")).toHaveText(title);
+}
+
+test("private uploader creates a named public gallery, compresses previews, and edits alt text", async ({ page }) => {
+  const title = "Studio collection " + crypto.randomUUID().slice(0, 8);
+  await signIn(page);
+  await createCollection(page, "portfolio", title);
+  await page.locator("#uploadFiles").setInputFiles(path.join(root, demoBase, "full/001.jpg"));
+  await page.locator("#uploadButton").click();
+  await expect(page.locator(".admin-photo")).toHaveCount(1);
+  await expect(page.locator("#uploadButton")).toBeEnabled();
+  await expect(page.locator(".admin-photo img")).toHaveAttribute("src", /\/api\/admin\/photos\/.+\/preview\//);
+  await expect(page.locator(".admin-photo textarea")).toHaveValue(new RegExp("Portrait image from " + title));
+  await page.locator(".admin-photo textarea").fill("An edited description approved by the photographer.");
+  await page.locator(".admin-photo button").click();
+  await expect(page.locator("#adminStatus")).toHaveText("Alt text saved.");
+  await page.locator("#publicConsent").check();
+  await page.locator("#publishCollection").click();
+  await expect(page.locator("#collectionVisibility")).toContainText("Published");
+  const url = await page.locator("#collectionLink").getAttribute("href");
+  expect(url).toMatch(/\/studio-collection-[a-f0-9]+\/$/);
+  await page.goto(url);
+  await expect(page.locator("h1")).toHaveText(title);
+  await expect(page.locator("#pagePhotoGrid img").first()).toHaveAttribute("alt", "An edited description approved by the photographer.");
+  await expect(page.locator("#pagePhotoGrid img").first()).toHaveAttribute("srcset", /\/media\//);
+  await expect(page.locator('link[rel="canonical"]')).toHaveAttribute("href", url);
+});
+
+test("client originals retain names and bytes through the uploader, portal, and streamed ZIP", async ({ page }) => {
+  const suffix = crypto.randomUUID().slice(0, 8);
+  const title = "Private delivery " + suffix;
+  const email = `client-${suffix}@example.com`;
+  const jpeg = await fs.readFile(path.join(root, demoBase, "full/001.jpg"));
+  const png = await fs.readFile(path.join(root, "assets/img/favicon-180.png"));
+  await signIn(page);
+  await createCollection(page, "delivery", title, email);
+  const instructions = await page.locator("#deliveryLoginDetails").textContent();
+  const code = instructions.match(/Code: (.+)/)[1];
+  await page.locator("#uploadFiles").setInputFiles([
+    { name: "Client original.JPG", mimeType: "image/jpeg", buffer: jpeg },
+    { name: "Print version.PNG", mimeType: "image/png", buffer: png }
+  ]);
+  await page.locator("#uploadButton").click();
+  await expect(page.locator(".admin-photo")).toHaveCount(2);
+  await expect(page.locator("#uploadButton")).toBeEnabled();
+  await expect(page.locator("#deliveryLoginDetails")).toContainText(code);
+  await page.locator("#publishCollection").click();
+  await expect(page.locator("#collectionVisibility")).toContainText("Released to the client");
+  await page.locator("#adminSignOut").click();
+  await expect(page.locator("#adminWorkspace")).toBeHidden();
+  await page.goto("client.html");
+  await page.locator("#g-email").fill(email);
+  await page.locator("#g-code").fill(code);
+  await page.locator("#loginBtn").click();
+  await expect(page.locator("#gTitle")).toHaveText(title);
+  await expect(page.locator(".photo-cell")).toHaveCount(2);
+  let zipRequests = 0;
+  page.on("request", request => { if (request.url().includes("jszip.min.js")) zipRequests++; });
+  const downloaded = page.waitForEvent("download");
+  await page.locator("#btnDownloadAll").click();
+  const download = await downloaded;
+  const zip = await JSZip.loadAsync(await fs.readFile(await download.path()));
+  expect(Object.keys(zip.files)).toHaveLength(2);
+  expect(await zip.file("Client original.JPG").async("nodebuffer")).toEqual(jpeg);
+  expect(await zip.file("Print version.PNG").async("nodebuffer")).toEqual(png);
+  expect(zipRequests).toBe(0);
+  await page.locator("#btnSelectMode").click();
+  await page.locator(".photo-cell").nth(1).click();
+  const oneFile = page.waitForEvent("download");
+  await page.locator("#abDownload").click();
+  const single = await oneFile;
+  expect(single.suggestedFilename()).toBe("Print version.PNG");
+  expect(await fs.readFile(await single.path())).toEqual(png);
+  await page.locator("#signOut").click();
+  await expect(page.locator("#loginView")).toBeVisible();
+});
+
+test("private admin can rotate a delivery code without changing its originals", async ({ page }) => {
+  const suffix = crypto.randomUUID().slice(0, 8);
+  await signIn(page);
+  await createCollection(page, "delivery", "Access reset " + suffix, `reset-${suffix}@example.com`);
+  const old = await page.locator("#deliveryLoginDetails").textContent();
+  page.once("dialog", dialog => dialog.accept());
+  await page.locator("#rotateDeliveryCode").click();
+  await expect(page.locator("#adminStatus")).toContainText("Access code replaced");
+  expect(await page.locator("#deliveryLoginDetails").textContent()).not.toBe(old);
+  await page.locator("#editDeliveryExpiry").fill("2036-01-01");
+  await page.locator("#saveDeliveryExpiry").click();
+  await expect(page.locator("#adminStatus")).toHaveText("Client-access expiry updated.");
+});
diff --git a/tests/browser/booking-sharing.spec.js b/tests/browser/booking-sharing.spec.js
